{
  "schemaVersion": 1,
  "id": "legacy-projectiles-scale",
  "version": "${version}",

  "name": "Legacy Projectiles Scale",
  "description": "Restores Minecraft 1.8 visuals for thrown projectiles: snowballs, ender pearls, splash potions (and eggs / XP bottles) render at half their modern size, and are never hidden in the first 2 ticks right in front of your face.",
  "authors": [
    "LegacyProjectilesScale"
  ],
  "contact": {},

  "license": "MIT",
  "environment": "client",

  "entrypoints": {
    "client": [
      "com.legacyprojectiles.LegacyProjectilesScaleClient"
    ],
    "modmenu": [
      "com.legacyprojectiles.config.ModMenuIntegration"
    ]
  },

  "mixins": [
    "legacy-projectiles-scale.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "cloth-config": ">=21.11"
  },

  "suggests": {
    "modmenu": ">=20.0.1"
  }
}
